generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Congregation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String
  type  CongregationType @default(HEADQUARTERS)
  since DateTime?

  zipCode              String?
  addressLinePrimary   String?
  addressLineSecondary String?
  district             String?
  city                 String?
  state                String?

  members              Member[]
  memberDepartments    MemberDepartment[]
  departmentLocalNames DepartmentLocalName[]
  eventSeries          EventSeries[]
  eventOccurrences     EventOccurrence[]
  transactions         Transaction[]
  treasuryConfig       TreasuryConfig?

  @@map("congregations")
}

model Member {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberNumber Int @unique

  congregationId String?       @db.ObjectId
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  name        String
  dateOfBirth DateTime?

  ssn        String?
  nationalId String?

  maritalStatus MaritalStatus?

  addressLinePrimary String?
  district           String?

  memberSince    DateTime?
  motherName     String?
  fatherName     String?
  naturality     String?
  nationality    String?   @default("Brasileira")
  convertionDate DateTime?

  phonePrimary   String?
  phoneSecondary String?
  photoUrl       String?
  photoBlobPath  String?

  status       MemberStatus @default(ACTIVE)
  observations String?

  clerkUserId String? @unique
  isAdmin     Boolean @default(false)

  departments MemberDepartment[]

  @@map("members")
}

model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name             String  @unique
  description      String?
  hasScopeDivision Boolean @default(true)

  memberships MemberDepartment[]
  functions   DepartmentFunction[]
  localNames  DepartmentLocalName[]
  eventSeries EventSeries[]
  events      EventOccurrence[]

  @@map("departments")
}

model DepartmentLocalName {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  departmentId   String       @db.ObjectId
  department     Department   @relation(fields: [departmentId], references: [id])
  congregationId String       @db.ObjectId
  congregation   Congregation @relation(fields: [congregationId], references: [id])

  @@unique([departmentId, congregationId])
  @@index([departmentId])
  @@index([congregationId])
  @@map("department_local_names")
}

model DepartmentFunction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  description  String?
  scope        DepartmentFunctionScope?
  sortOrder    Int                      @default(0)
  departmentId String                   @db.ObjectId
  department   Department               @relation(fields: [departmentId], references: [id])

  memberships     MemberDepartment[]
  profileBindings RbacProfileBinding[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([departmentId, sortOrder])
  @@map("department_functions")
}

model MemberDepartment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId       String              @db.ObjectId
  member         Member              @relation(fields: [memberId], references: [id])
  departmentId   String              @db.ObjectId
  department     Department          @relation(fields: [departmentId], references: [id])
  scope          DepartmentScope?
  congregationId String?             @db.ObjectId
  congregation   Congregation?       @relation(fields: [congregationId], references: [id])
  functionId     String?             @db.ObjectId
  function       DepartmentFunction? @relation(fields: [functionId], references: [id])

  @@unique([memberId, departmentId, scope, congregationId, functionId])
  @@index([memberId])
  @@index([departmentId])
  @@index([congregationId])
  @@index([functionId])
  @@map("member_departments")
}

model EventSeries {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  timezone    String  @default("America/Sao_Paulo")

  congregationId String       @db.ObjectId
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  departmentId   String?      @db.ObjectId
  department     Department?  @relation(fields: [departmentId], references: [id])

  eventType EventSeriesType

  startsOn DateTime
  endsOn   DateTime?

  sameTimeStartMinutes Int?

  monthlyWeekday Int?
  monthlyOrdinal Int?

  rotationCongregationIds String[]  @default([]) @db.ObjectId
  rotationStartDate       DateTime?

  daySchedules EventSeriesDaySchedule[]
  occurrences  EventOccurrence[]

  @@index([congregationId])
  @@index([departmentId])
  @@index([eventType])
  @@map("event_series")
}

model EventSeriesDaySchedule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seriesId String      @db.ObjectId
  series   EventSeries @relation(fields: [seriesId], references: [id])

  date         DateTime
  startMinutes Int
  endMinutes   Int

  @@index([seriesId])
  @@index([date])
  @@map("event_series_day_schedules")
}

model EventOccurrence {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seriesId String      @db.ObjectId
  series   EventSeries @relation(fields: [seriesId], references: [id])

  congregationId String       @db.ObjectId
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  departmentId   String?      @db.ObjectId
  department     Department?  @relation(fields: [departmentId], references: [id])

  title       String
  description String?
  timezone    String

  startAt DateTime
  endAt   DateTime

  occurrenceDate DateTime

  isException Boolean @default(false)
  cancelled   Boolean @default(false)

  @@index([seriesId])
  @@index([congregationId])
  @@index([departmentId])
  @@index([startAt, endAt])
  @@index([occurrenceDate])
  @@index([cancelled])
  @@map("event_occurrences")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum MemberStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
}

enum CongregationType {
  HEADQUARTERS
  BRANCH
  SUB_BRANCH
}

enum DepartmentScope {
  LOCAL
  GENERAL
}

enum DepartmentFunctionScope {
  BOTH
  LOCAL
  GENERAL
}

enum EventSeriesType {
  SINGLE_DAY
  MULTI_DAY
  MONTHLY_RECURRING
}

enum TransactionType {
  INCOME
  EXPENSE
}

model TransactionCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique

  transactions Transaction[]

  @@map("transaction_categories")
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  type   TransactionType
  amount Float
  date   DateTime        @default(now())
  notes  String?

  categoryId String?              @db.ObjectId
  category   TransactionCategory? @relation(fields: [categoryId], references: [id])

  congregationId String?       @db.ObjectId
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  attachments TransactionAttachment[]

  @@index([type])
  @@index([date])
  @@index([categoryId])
  @@index([congregationId])
  @@map("transactions")
}

model TransactionAttachment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  transactionId String      @db.ObjectId
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  fileName String
  fileType String
  fileSize Int
  blobPath String
  blobUrl  String

  @@index([transactionId])
  @@map("transaction_attachments")
}

model TreasuryConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregationId String?       @unique @db.ObjectId
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  initialBalance     Float    @default(0)
  initialBalanceDate DateTime @default(now())

  @@map("treasury_configs")
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  MANAGE
}

enum PermissionScopeType {
  ALL
  OWN_CONGREGATION
}

model RbacProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  permissions RbacPermission[]
  bindings    RbacProfileBinding[]

  @@map("rbac_profiles")
}

model RbacPermission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId String      @db.ObjectId
  profile   RbacProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  resource  String
  action    PermissionAction
  scopeType PermissionScopeType @default(ALL)

  @@unique([profileId, resource, action])
  @@index([profileId])
  @@map("rbac_permissions")
}

model RbacProfileBinding {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profileId  String             @db.ObjectId
  profile    RbacProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  functionId String             @db.ObjectId
  function   DepartmentFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  scope      DepartmentScope

  @@unique([profileId, functionId, scope])
  @@index([functionId, scope])
  @@index([profileId])
  @@map("rbac_profile_bindings")
}
