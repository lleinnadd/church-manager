generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Congregation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String
  type  CongregationType @default(HEADQUARTERS)
  since DateTime?

  zipCode              String?
  addressLinePrimary   String?
  addressLineSecondary String?
  district             String?
  city                 String?
  state                String?

  members           Member[]
  memberDepartments MemberDepartment[]

  @@map("congregations")
}

model Member {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregationId String?       @db.ObjectId
  congregation   Congregation? @relation(fields: [congregationId], references: [id])

  name        String
  dateOfBirth DateTime?

  ssn        String?
  nationalId String?

  maritalStatus MaritalStatus?

  addressLinePrimary String?
  district           String?

  memberSince    DateTime?
  motherName     String?
  fatherName     String?
  naturality     String?
  nationality    String?   @default("Brasileira")
  convertionDate DateTime?

  phonePrimary   String?
  phoneSecondary String?

  status       MemberStatus @default(ACTIVE)
  observations String?

  clerkUserId String? @unique

  departments MemberDepartment[]

  @@map("members")
}

model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name             String  @unique
  description      String?
  hasScopeDivision Boolean @default(true)

  memberships MemberDepartment[]
  functions   DepartmentFunction[]

  @@map("departments")
}

model DepartmentFunction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  description  String?
  sortOrder    Int        @default(0)
  departmentId String     @db.ObjectId
  department   Department @relation(fields: [departmentId], references: [id])

  memberships MemberDepartment[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([departmentId, sortOrder])
  @@map("department_functions")
}

model MemberDepartment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId       String              @db.ObjectId
  member         Member              @relation(fields: [memberId], references: [id])
  departmentId   String              @db.ObjectId
  department     Department          @relation(fields: [departmentId], references: [id])
  scope          DepartmentScope?
  congregationId String?             @db.ObjectId
  congregation   Congregation?       @relation(fields: [congregationId], references: [id])
  functionId     String?             @db.ObjectId
  function       DepartmentFunction? @relation(fields: [functionId], references: [id])

  @@unique([memberId, departmentId, scope, congregationId, functionId])
  @@index([memberId])
  @@index([departmentId])
  @@index([congregationId])
  @@index([functionId])
  @@map("member_departments")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum MemberStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
}

enum CongregationType {
  HEADQUARTERS
  BRANCH
  SUB_BRANCH
}

enum DepartmentScope {
  LOCAL
  GENERAL
}
